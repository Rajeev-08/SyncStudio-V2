{
  "name": "syncstudio",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build && esbuild apps/api/src/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/api/index.js && esbuild apps/runner/src/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/runner/index.js",
    "start": "node --env-file-if-exists=.env dist/api/index.js",
    "check": "npm run lint && npm run test && npm run build",
    "seed": "tsx scripts/seed.ts",
    "predev": "node scripts/build-preview.mjs",
    "prebuild": "node scripts/build-preview.mjs",
    "test:mongo": "vitest run --config vitest.mongo.config.ts",
    "format": "prettier --write apps/api/src apps/web/src packages/shared/src tests scripts",
    "ide:setup": "node scripts/setup-ide.mjs",
    "ide:build": "node scripts/ide.mjs build",
    "ide:start": "node scripts/ide.mjs start",
    "ide:stop": "node scripts/stop-ide.mjs",
    "test:ide": "tsx tests/ide.smoke.ts",
    "local:setup": "node scripts/setup-local.mjs",
    "ide:doctor": "node scripts/ide.mjs doctor",
    "ide:up": "node scripts/ide.mjs up",
    "ide:logs": "node scripts/ide.mjs logs"
  },
  "dependencies": {
    "@babel/standalone": "^7.28.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.90.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.0",
    "esbuild": "^0.25.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.55.0",
    "mongoose": "^8.18.0",
    "pino": "^9.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.8.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.32",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/babel__standalone": "^7.1.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.34.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
